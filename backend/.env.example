# Copia este archivo como ".env" y llena tus datos. NUNCA subas el .env a Git.

# ---------- Gemini ----------
# Créala gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modelo de respaldo si el principal está saturado (error 503)
GEMINI_MODEL_RESPALDO=gemini-flash-lite-latest

# ---------- SQL Server ----------
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=Hakaton_JR

# Usuario del backend (lectura y escritura).
# Déjalos vacíos para usar autenticación de Windows.
DB_APP_USER=
DB_APP_PASSWORD=

# Usuario de solo lectura para las consultas SQL que escribe la IA (ver database/02_usuarios.sql).
# Si lo dejas vacío se usa la conexión del backend.
DB_IA_USER=
DB_IA_PASSWORD=
